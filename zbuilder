FROM --platform=$BUILDPLATFORM oven/bun:latest AS bun

FROM --platform=$BUILDPLATFORM node:24-bookworm AS build

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app

COPY package.json ./
RUN bun install

COPY --exclude=node_modules \
    --exclude=.git \
    --exclude=target \
    --exclude=docs/.vitepress/cache \
    --exclude=docs/.vitepress/dist \
    --exclude=docs/.vitepress/.temp \
    --exclude=.env* \
    --exclude=.agents \
    --exclude=docker-migration \
    . .
RUN bun run vitepress build docs

FROM caddy:2-alpine

COPY --from=build /app/docs/.vitepress/dist /srv

COPY <<'EOF' /etc/caddy/Caddyfile
:80 {
    root * /srv
    encode zstd gzip

    try_files {path} {path}.html
    file_server

    handle_errors 404 {
        rewrite * /404.html
        file_server
    }
}
EOF

EXPOSE 80
