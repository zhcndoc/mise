FROM --platform=$BUILDPLATFORM node:24-bookworm AS builder

WORKDIR /app

ENV CI=true

RUN npm install -g @endevco/aube@2.7.2 --allow-scripts=@endevco/aube

COPY . .

RUN aube install --frozen-lockfile

RUN aube exec vitepress build docs

FROM ikxin/caddy:latest

COPY --from=builder /app/docs/.vitepress/dist /usr/share/caddy

EXPOSE 8080
